# =============================
# Terraform core directories
# =============================
.terraform/

# Lock file (optional: usually keep this in repo for reproducibility)
# Uncomment if you want to ignore it
.terraform.lock.hcl

# =============================
# Terraform state files (NEVER COMMIT)
# =============================
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# =============================
# Sensitive variable files
# =============================
*.tfvars
*.tfvars.json

# =============================
# Override files
# =============================
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =============================
# CLI config files
# =============================
.terraformrc
terraform.rc

# =============================
# Plan files
# =============================
*.tfplan
*.plan
*.out

# =============================
# Logs
# =============================
*.log

# =============================
# SSH Keys (CRITICAL)
# =============================
*.pem
*.key

# =============================
# OS / Editor files
# =============================
.DS_Store
Thumbs.db

# =============================
# IDEs
# =============================
.vscode/
.idea/